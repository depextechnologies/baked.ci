# Copy to backend/.env and fill in real values before `docker compose up`.
# backend/.env is git-ignored — never commit real secrets.

# --- Database (container name "postgres" from docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://baked:baked@postgres:5432/baked

# --- Public URL of the site (must match REACT_APP_BACKEND_URL below) ---
REACT_APP_BACKEND_URL=https://your-domain.com

# --- CORS: comma-separated list of browser origins allowed to call this API.
# Required in production (APP_ENV=production) — startup fails if unset. ---
CORS_ORIGINS=https://your-domain.com

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-value
JWT_ACCESS_TTL_MIN=1440

# --- Environment flags ---
APP_ENV=production
BAKED_ENV=production
EXPRESS_DEMO_MODE=false

# --- Admin seed account (created on first startup) ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Super Admin

# --- Payments / OTP providers ---
PAYMENT_PROVIDER=cod
OTP_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
AT_USERNAME=
AT_API_KEY=

# --- AI integration ---
EMERGENT_LLM_KEY=
