# Copy to .env at the repo root (used by docker-compose.yml at build time).
# Must match REACT_APP_BACKEND_URL set in backend/.env.
REACT_APP_BACKEND_URL=https://your-domain.com

# Google Maps JS API key for the address picker / Express live tracking maps.
# Leave blank to show the "map unavailable" fallback instead.
REACT_APP_GOOGLE_MAPS_API_KEY=
